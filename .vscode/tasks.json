{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "安装依赖",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m pip install -r requirements.txt",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "初始化知识库",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe knowledge/scripts/import_hardcoded_data.py",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "启动 Web 服务",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe api_server.py --port 8000",
      "problemMatcher": [],
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
