{
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "python.analysis.typeCheckingMode": "basic",
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.associations": {
    "*.yaml": "yaml"
  },
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/knowledge/data": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true
  }
}
