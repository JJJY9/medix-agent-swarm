# 复制为 .env 后填写，即可覆盖上一层的 config.py（环境变量优先级更高）
#
# API Key 获取：火山方舟控制台 https://console.volcengine.com/ark
# 也支持任何 OpenAI 兼容接口（DeepSeek / 通义 / OpenAI 等），改 base_url 即可

MEDIX_API_KEY=
MEDIX_MODEL=doubao-seed-1-6-flash-250828
MEDIX_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 可选：Mem0 长期记忆（不填则自动降级，仅使用短期记忆）
MEM0_API_KEY=
