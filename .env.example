# 复制为 .env 后填写，即可覆盖上一层的 config.py（环境变量优先级更高）
#
# API Key 获取：火山方舟控制台 https://console.volcengine.com/ark
# 也支持任何 OpenAI 兼容接口（DeepSeek / 通义 / OpenAI 等），改 base_url 即可

MEDIX_API_KEY=
MEDIX_MODEL=doubao-seed-1-6-flash-250828
MEDIX_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 可选：模型请求超时（秒），默认 60
MEDIX_TIMEOUT=60

# 可选：单个技能（网络检索、记忆查询等）最长执行秒数，默认 60
MEDIX_SKILL_TIMEOUT=60

# 可选：访问令牌。设置后除 /api/status 外的 API 都需要 X-Medix-Token 请求头，
# 浏览器首次打开会提示输入。用 --host 0.0.0.0 暴露到局域网时建议设置。
MEDIX_ACCESS_TOKEN=

# 可选：会诊接口每分钟最多请求次数，默认 30；设为 0 关闭限流
MEDIX_RATE_LIMIT=30

# 可选：模型费用估算单价（每百万 tokens），用于界面预估，实际以服务商账单为准
# 例如输入 2 元/百万、输出 8 元/百万
MEDIX_PRICE_INPUT=0
MEDIX_PRICE_OUTPUT=0
MEDIX_CURRENCY=¥

# 可选：每月 Token 预算；设置后历史抽屉显示本月用量进度与超限提醒
# 0 或留空表示不启用
MEDIX_MONTHLY_TOKEN_BUDGET=0

# 可选：自动归档超过 N 天的会话（0 或留空关闭）
# 归档不会删除数据，仍可在历史抽屉的「已归档」中查看与恢复
MEDIX_AUTO_ARCHIVE_DAYS=0

# 可选：本地自动备份间隔小时（0 或留空关闭）
# 备份写入 data/backups/，包含完整会话与健康数据，请确保磁盘空间与隐私
MEDIX_AUTO_BACKUP_HOURS=0
# 可选：保留最近几份自动备份（默认 7）
MEDIX_BACKUP_KEEP=7
# 可选：自定义备份目录（默认 data/backups）
# MEDIX_BACKUP_DIR=data/backups

# 可选：会话与健康数据的 SQLite 文件路径（默认 data/sessions.db）
# MEDIX_SESSION_DB=data/sessions.db

# 可选：Mem0 长期记忆（不填则自动降级，仅使用短期记忆）
MEM0_API_KEY=
